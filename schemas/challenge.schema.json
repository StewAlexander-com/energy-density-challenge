{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Challenge",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "challenge": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "problem_framing",
        "bounded_investigation"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "first_assignment": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "minimize",
              "maximize",
              "contextual"
            ]
          },
          "boundary_required": {
            "const": true
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "missing_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "unit",
          "direction",
          "boundary_required",
          "value",
          "missing_reason"
        ]
      }
    },
    "research_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_failures": {
      "type": "array"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "status": {
                "enum": [
                  "unresolved",
                  "plausible_experiment_required",
                  "falsified",
                  "supported_within_tested_conditions"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "date",
              "status",
              "reason"
            ]
          }
        }
      },
      "required": [
        "value",
        "basis",
        "history"
      ]
    },
    "experiments_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "schema_version",
    "challenge",
    "phase",
    "hypothesis",
    "first_assignment",
    "objectives",
    "constraints",
    "metrics",
    "research_domains",
    "unresolved_questions",
    "known_failures",
    "evidence",
    "confidence",
    "experiments_needed",
    "safety_requirements",
    "last_updated"
  ]
}
