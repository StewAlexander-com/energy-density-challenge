{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EDC-R-[0-9]{4}$"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_kind": {
      "enum": [
        "desk_analysis",
        "simulation",
        "observation",
        "experimental_result"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path_or_url": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path_or_url",
          "license",
          "provenance"
        ]
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replication_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety_scope": {
      "type": "string",
      "minLength": 1
    },
    "tested_conditions": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "experiment_id",
    "evidence_kind",
    "date",
    "method",
    "data",
    "outcome",
    "uncertainty",
    "limitations",
    "deviations",
    "authors",
    "replication_group",
    "safety_scope",
    "tested_conditions"
  ]
}
